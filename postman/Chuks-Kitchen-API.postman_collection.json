          "raw": "{\n  \"status\": \"Confirmed\",\n  \"actor\": \"admin\"\n}"
        },
        "url": "{{baseUrl}}/api/orders/{{orderId}}/status"
      }
    },
    {
      "name": "Cancel Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actor\": \"customer\"\n}"
        },
        "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel"
