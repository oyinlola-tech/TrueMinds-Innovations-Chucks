      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Fried Rice & Turkey\",\n  \"description\": \"Special fried rice with grilled turkey.\",\n  \"price\": 5000,\n  \"adminKey\": \"admin-123\"\n}"
        },
        "url": "{{baseUrl}}/api/foods"
      }
    },
    {
      "name": "Update Food Availability",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isAvailable\": false,\n  \"adminKey\": \"admin-123\"\n}"
        },
        "url": "{{baseUrl}}/api/foods/{{foodId}}"
      }
    },
    {
