      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"foodId\": \"food_1\",\n  \"quantity\": 2\n}"
        },
        "url": "{{baseUrl}}/api/cart/items"
      }
    },
    {
      "name": "View Cart",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/cart/{{userId}}"
      }
    },
    {
      "name": "Clear Cart",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/cart/{{userId}}/clear"
      }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"paymentCompleted\": true\n}"
        },
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "List Orders (New Endpoint)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
