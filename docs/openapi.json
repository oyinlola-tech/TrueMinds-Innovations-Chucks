{
  "openapi": "3.0.3",
  "info": {
    "title": "Chuks Kitchen API",
    "version": "1.0.0",
    "description": "Food ordering and customer management backend"
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "paths": {
    "/api/signup": {
      "post": {
        "summary": "Register user (email or phone)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": { "type": "string" },
                  "email": { "type": "string" },
                  "phone": { "type": "string" },
                  "referralCode": { "type": "string" }
                },
                "required": ["fullName"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/api/verify": {
      "post": {
        "summary": "Verify OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "string" },
                  "otp": { "type": "string" }
                },
                "required": ["userId", "otp"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Verified" }
        }
      }
    },
    "/api/foods": {
      "get": {
        "summary": "List foods",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "summary": "Add food item (admin simulation)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "price": { "type": "number" },
                  "currency": { "type": "string" },
                  "isAvailable": { "type": "boolean" },
                  "adminKey": { "type": "string" }
                },
                "required": ["name", "description", "price", "adminKey"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/api/foods/{id}": {
      "patch": {
        "summary": "Update food item",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "price": { "type": "number" },
                  "isAvailable": { "type": "boolean" },
                  "adminKey": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated" }
        }
      }
    },
    "/api/cart/items": {
      "post": {
        "summary": "Add meal to cart",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "string" },
                  "foodId": { "type": "string" },
                  "quantity": { "type": "integer" }
                },
                "required": ["userId", "foodId", "quantity"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/cart/{userId}": {
      "get": {
        "summary": "View cart by userId",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/cart/{userId}/clear": {
      "post": {
        "summary": "Clear cart",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/orders": {
      "post": {
        "summary": "Create order from cart",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "string" },
                  "paymentCompleted": { "type": "boolean" }
                },
                "required": ["userId"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      },
      "get": {
        "summary": "List orders (new endpoint)",
        "parameters": [
          {
            "in": "query",
            "name": "userId",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "summary": "Get order details by id",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/orders/{id}/status": {
      "patch": {
        "summary": "Update order status",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string" },
                  "actor": { "type": "string" }
                },
                "required": ["status"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated" }
        }
      }
    },
    "/api/orders/{id}/cancel": {
      "post": {
        "summary": "Cancel order",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actor": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Cancelled" }
        }
      }
    }
  }
}
